# Cloudflare Pages redirect rules.
# Static export has no middleware, so locale entry and legacy-URL preservation
# are handled here at the edge instead.

# Bare root -> default locale. 302 (not 301) so the client-side language
# preference handler can still move visitors to their own locale without the
# browser having permanently cached this hop.
/            /ko/            302

# Legacy SPA URLs. The old site served every language from these two paths and
# advertised itself as Korean, so equity is consolidated onto /ko/ and the
# preference handler forwards visitors of other languages.
/list        /ko/digimon/    301
/list/       /ko/digimon/    301
