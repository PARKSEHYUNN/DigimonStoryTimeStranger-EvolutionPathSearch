{
  "name": "evolutionpath",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "admin": "vite --config tools/admin/vite.config.ts",
    "build": "npm run data:validate && next build && node scripts/prune-export.mjs && node scripts/write-ads-txt.mjs && node scripts/check-fonts.mjs",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:fonts": "node scripts/check-fonts.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:admin": "node scripts/check-admin.mjs",
    "data:validate": "node scripts/validate-data.ts",
    "data:migrate": "node tools/migrate-legacy.mjs",
    "icons:optimize": "node scripts/optimize-icons.mjs",
    "icons:app": "node scripts/generate-icons.mjs",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "data:server": "node tools/data-server.ts"
  },
  "dependencies": {
    "lucide-react": "^0.549.0",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-virtuoso": "^4.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "puppeteer-core": "^25.4.0",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
