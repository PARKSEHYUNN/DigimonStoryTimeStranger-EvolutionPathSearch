# 빌드 시점에 인라인되는 값들. 정적 익스포트라 런타임에 읽는 서버가 없고,
# 값을 바꾸면 재배포가 필요하다. 운영에서는 Cloudflare Pages 프로젝트의
# Settings → Environment variables 에 넣는다.
#
# 이 파일을 .env.local 로 복사해서 로컬 확인용으로 쓴다. .env* 는 커밋되지 않는다.

# ---------------------------------------------------------------------------
# Adsterra
# ---------------------------------------------------------------------------
# 이 변수는 "광고 코드를 실제로 실행할 것인가"만 정한다. "true" 일 때만 켜지며,
# 그 외에는 스크립트도 네트워크 요청도 없고 AdSlot 은 자리만 잡는 플레이스홀더로 남는다.
#
# 프리뷰 배포(*.pages.dev)에는 설정하지 않는다. 승인되지 않은 도메인에서
# 광고를 노출하는 것은 대부분의 광고 네트워크 정책 위반이다.
NEXT_PUBLIC_ADS_ENABLED=

# 리더보드(본문 최상단) 자리의 배너 존 키. Adsterra 대시보드에서 발급받은
# invoke.js URL 안의 key 값이다. 데스크톱/모바일 둘 다 있어야 켜진다 —
# 하나만 있으면 다른 쪽 화면 크기에서 광고가 안 뜨는데 그걸 알 방법이 없다.
NEXT_PUBLIC_ADSTERRA_LEADERBOARD_DESKTOP_KEY=
NEXT_PUBLIC_ADSTERRA_LEADERBOARD_MOBILE_KEY=

# in-content(검색 폼과 결과 사이) / footer(디지몬 상세 페이지 하단) 자리는
# 같은 Native Banner 존 하나를 공유한다 — 홈 화면엔 footer 자리가 없고 상세
# 페이지엔 in-content 자리가 없어서 겹칠 일이 없다.
NEXT_PUBLIC_ADSTERRA_NATIVE_CONTAINER_ID=
NEXT_PUBLIC_ADSTERRA_NATIVE_SCRIPT_SRC=

# ads.txt는 안 쓴다 — Adsterra는 광고주가 이를 요구하지 않아 파일 자체를
# 제공하지 않는다고 밝히고 있다.

# ---------------------------------------------------------------------------
# Cloudflare Web Analytics
# ---------------------------------------------------------------------------
# Pages 대시보드에서 Web Analytics 를 켰다면 이 값은 비워둔다. 둘 다 켜면
# 조회수가 두 배로 잡힌다. DEPLOY.md 4번 참고.
NEXT_PUBLIC_CF_BEACON_TOKEN=
